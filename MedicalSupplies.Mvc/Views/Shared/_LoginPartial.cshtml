@using Microsoft.AspNetCore.Identity
@using MedicalSupplies.Mvc.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul style="display: flex; gap: 15px; list-style: none; margin: 0; padding: 0;">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <a asp-controller="Home" asp-action="Index" title="Manage">Hello @User.Identity?.Name!</a>
    </li>
    <li>
        <form form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-light" style="padding: 4px 10px;">Logout</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="btn btn-light" style="padding: 4px 10px;" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li>
        <a class="btn btn-light" style="padding: 4px 10px;" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
