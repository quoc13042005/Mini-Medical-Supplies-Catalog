<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicalSupplies.Mvc</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <div class="brand">
                <a asp-controller="Home" asp-action="Index">MedicalSupplies.Mvc</a>
            </div>

                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Supplies" asp-action="Index">Vật Tư</a>
                <a asp-controller="Supplies" asp-action="Filter">Lọc (F2)</a>
                <a asp-controller="Issues" asp-action="Create">Xuất Kho</a>
                <a asp-controller="DataHealth" asp-action="Index">Health Check</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>&copy; 2025 - MedicalSupplies.Mvc - Lab03</span>
            <a href="#">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
