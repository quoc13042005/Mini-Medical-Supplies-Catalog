<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicalSupplies.Mvc</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-content">
            <div class="brand">
                <a asp-controller="Home" asp-action="Index">MedicalSupplies.Mvc</a>
            </div>
            <nav class="main-nav">
                <a asp-area="" asp-controller="Supplies" asp-action="Index">Quản lý Vật tư</a>
                <a asp-area="" asp-controller="Supplies" asp-action="Search">Tìm kiếm</a>
                <a asp-area="" asp-controller="Supplies" asp-action="Trash">Thùng rác</a>
                <a asp-area="" asp-controller="AuditLogs" asp-action="Index">Audit Logs</a>
                <a asp-area="" asp-controller="DataHealth" asp-action="Index">Data Health</a>
                <a class="text-danger fw-bold" href="/api/supplies/9999">API Error Demo</a>
            </nav>
            <partial name="_LoginPartial" />
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>&copy; 2025 - MedicalSupplies.Mvc - Lab06</span>
            <a href="#">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
