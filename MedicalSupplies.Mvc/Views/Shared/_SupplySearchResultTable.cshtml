@model IEnumerable<MedicalSupplies.Mvc.Models.Supply>

<table class="table">
    <thead>
        <tr>
            <th>Mã vật tư</th>
            <th>Tên vật tư</th>
            <th>Nhóm</th>
            <th>Nhà CC</th>
            <th>Đơn giá</th>
            <th>SL tồn</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supply in Model)
        {
            <tr>
                <td><strong>@supply.Code</strong></td>
                <td>@supply.Name</td>
                <td>
                    <span class="badge badge-secondary">
                        @supply.Category?.Name
                    </span>
                </td>
                <td>@supply.Provider</td>
                <td class="product-price">@supply.Price.ToString("N0") đ</td>
                <td>@supply.Quantity</td>
                <td>
                    <a asp-controller="Supplies"
                       asp-action="Detail"
                       asp-route-id="@supply.Id"
                       class="btn btn-sm btn-light">
                        Xem
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
