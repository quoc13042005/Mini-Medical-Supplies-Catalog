@model MedicalSupplies.Mvc.ViewModels.IssueCreateViewModel

@{
    ViewData["Title"] = "Tạo Phiếu Xuất Kho";
}

<h2>Tạo Phiếu Xuất Kho (Transaction)</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
}

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="ReceiverName" class="form-label">Người/Đơn vị nhận</label>
        <input asp-for="ReceiverName" class="form-control" />
        <span asp-validation-for="ReceiverName" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="SupplyId" class="form-label">Supply ID</label>
        <input asp-for="SupplyId" class="form-control" placeholder="ID của vật tư (VD: 1)" />
        <span asp-validation-for="SupplyId" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Số lượng xuất</label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Xuất Kho</button>
    <a href="/Supplies" class="btn btn-secondary">Trở về danh sách</a>
</form>
