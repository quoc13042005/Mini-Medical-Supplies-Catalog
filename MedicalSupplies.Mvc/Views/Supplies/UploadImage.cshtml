@model MedicalSupplies.Mvc.Models.Supply
@{
    ViewData["Title"] = "Upload Image";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Upload Image for: @Model.Name</h1>
    </div>
</div>

<div class="form-layout">
    <div class="form-box">
        <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-3">
                    <p>Current Image:</p>
                    <img src="@Model.ImagePath" alt="@Model.Name" style="max-width: 200px;" />
                </div>
            }

            <div class="form-group">
                <label>Select new image (jpg, jpeg, png, webp) - max 2MB:</label>
                <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Upload</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
