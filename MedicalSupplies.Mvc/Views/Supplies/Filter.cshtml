@model IEnumerable<MedicalSupplies.Mvc.ViewModels.SupplyListItemViewModel>

@{
    ViewData["Title"] = "Lọc Vật Tư Y Tế";
}

<h2>Lọc Vật Tư Y Tế (Feature 2)</h2>

<form method="get" action="/Supplies/Filter" class="mb-4 d-flex gap-2 align-items-center">
    <input type="number" name="categoryId" class="form-control w-auto" placeholder="Category ID (e.g. 1)" value="@ViewBag.CategoryId" />
    <input type="number" name="minPrice" class="form-control w-auto" placeholder="Giá từ" value="@ViewBag.MinPrice" />
    <input type="number" name="maxPrice" class="form-control w-auto" placeholder="Giá đến" value="@ViewBag.MaxPrice" />
    <button type="submit" class="btn btn-primary">Lọc</button>
    <a href="/Supplies/Filter" class="btn btn-outline-secondary">Xóa</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Mã Vạch</th>
            <th>Tên</th>
            <th>Danh mục</th>
            <th>Nhà cung cấp</th>
            <th>Giá</th>
            <th>Tồn kho</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Barcode</td>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.Provider</td>
                <td>@item.Price.ToString("N0")</td>
                <td>@item.Quantity</td>
                <td>@item.Status</td>
            </tr>
        }
    </tbody>
</table>
