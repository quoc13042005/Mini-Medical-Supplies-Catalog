@model MedicalSupplies.Mvc.ViewModels.SupplyIndexViewModel

@{
    ViewData["Title"] = "Danh sách Vật tư Y tế";
}

<h2>Danh sách Vật tư Y tế</h2>

<div class="row mb-3">
    <div class="col-md-9">
        <form asp-controller="Supplies" asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Tìm theo mã hoặc tên..." />
            
            <select name="category" asp-for="Category" asp-items="Model.Categories" class="form-select w-auto">
            </select>

            <select name="status" asp-for="Status" asp-items="Model.StatusList" class="form-select w-auto">
            </select>
            
            <button type="submit" class="btn btn-primary text-nowrap">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">Xóa lọc</a>
        </form>
    </div>
    <div class="col-md-3 text-end">
        <a href="/Supplies/Stats" class="btn btn-info">Xem Thống kê</a>
    </div>
</div>

@if (!Model.Supplies.Any())
{
    <div class="alert alert-warning">Không tìm thấy vật tư y tế nào phù hợp với bộ lọc.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mã VT</th>
                <th>Tên vật tư</th>
                <th>Nhóm</th>
                <th>Đơn giá</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Supplies)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Price.ToString("N0") VNĐ</td>
                    <td>
                        @if (item.Status == MedicalSupplies.Mvc.Models.SupplyStatus.InStock)
                        {
                            <span class="badge bg-success">Còn hàng</span>
                        }
                        else if (item.Status == MedicalSupplies.Mvc.Models.SupplyStatus.NeedsRestock)
                        {
                            <span class="badge bg-warning text-dark">Cần nhập thêm</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Hết hàng</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Supplies" asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage - 1)" 
                       asp-route-searchString="@Model.SearchString" 
                       asp-route-category="@Model.Category"
                       asp-route-status="@Model.Status">Trước</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-searchString="@Model.SearchString" 
                           asp-route-category="@Model.Category"
                           asp-route-status="@Model.Status">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage + 1)" 
                       asp-route-searchString="@Model.SearchString" 
                       asp-route-category="@Model.Category"
                       asp-route-status="@Model.Status">Tiếp</a>
                </li>
            </ul>
        </nav>
    }
}
