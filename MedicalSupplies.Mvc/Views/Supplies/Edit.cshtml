@model MedicalSupplies.Mvc.ViewModels.SupplyEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa Vật tư";
}

<h2>Chỉnh sửa Vật tư</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Code">Mã Vật Tư</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Name">Tên Vật Tư</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Barcode">Mã Vạch</label>
                <input asp-for="Barcode" class="form-control" />
                <span asp-validation-for="Barcode" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SupplyCategoryId">Danh mục</label>
                <select asp-for="SupplyCategoryId" class="form-control">
                    <option value="1">Vật tư tiêu hao</option>
                    <option value="2">Dụng cụ tiêm truyền</option>
                    <option value="3">Thiết bị y tế</option>
                </select>
                <span asp-validation-for="SupplyCategoryId" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Provider">Nhà Cung Cấp</label>
                <input asp-for="Provider" class="form-control" />
                <span asp-validation-for="Provider" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price">Đơn giá</label>
                <input asp-for="Price" class="form-control" type="text" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity">Số lượng Tồn kho</label>
                <input asp-for="Quantity" class="form-control" type="number" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        </div>
    </div>
    
    <button type="submit" class="btn btn-warning mt-3">Cập nhật</button>
    <a href="/Supplies/Index" class="btn btn-secondary mt-3">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
