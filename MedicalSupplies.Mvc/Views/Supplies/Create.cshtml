@model MedicalSupplies.Mvc.ViewModels.SupplyCreateViewModel

@{
    ViewData["Title"] = "Thêm Vật tư";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Thêm Vật tư Y tế</h2>
        <p class="page-description">
            Form POST dùng asp-for để thêm vật tư y tế mới vào hệ thống.
        </p>
    </div>

    <a class="btn btn-light"
       asp-controller="Supplies"
       asp-action="Index">
        Quay lại danh sách
    </a>
</div>

<div class="form-layout">
    <form class="form-box"
          asp-controller="Supplies"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Code">Mã vật tư</label>
            <input asp-for="Code"
                   class="form-control"
                   placeholder="Ví dụ: MS006" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Name">Tên vật tư</label>
            <input asp-for="Name"
                   class="form-control"
                   placeholder="Ví dụ: Bông y tế" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Category">Nhóm vật tư</label>
            <input asp-for="Category"
                   class="form-control"
                   placeholder="Ví dụ: Vật tư tiêu hao" />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Provider">Nhà cung cấp</label>
            <input asp-for="Provider"
                   class="form-control"
                   placeholder="Ví dụ: Bạch Tuyết" />
            <span asp-validation-for="Provider" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price">Đơn giá</label>
            <input asp-for="Price"
                   class="form-control"
                   placeholder="Ví dụ: 25000" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Quantity">Số lượng tồn</label>
            <input asp-for="Quantity"
                   class="form-control"
                   placeholder="Ví dụ: 100" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MinQuantity">Mức tồn tối thiểu</label>
            <input asp-for="MinQuantity"
                   class="form-control"
                   placeholder="Ví dụ: 20" />
            <span asp-validation-for="MinQuantity" class="text-danger"></span>
        </div>

        <button class="btn" type="submit">
            Lưu Vật tư
        </button>

        <a class="btn btn-secondary"
           asp-controller="Supplies"
           asp-action="Index">
            Hủy bỏ
        </a>
    </form>

    <div class="info-box">
        <h3>Lưu ý khi thêm</h3>
        <p>
            Vui lòng điền đầy đủ mã vật tư và nhóm vật tư.
            Số lượng không được âm và đơn giá phải lớn hơn 0.
        </p>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
