@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Data Health Check";
}

<h2>Tình trạng Database & Khả năng xử lý</h2>

<table class="table table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Mục kiểm tra</th>
            <th>Mong đợi</th>
            <th>Thực tế</th>
            <th>Trạng thái</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Check</td>
                <td>@item.Expected</td>
                <td>@item.Actual</td>
                <td>
                    @if (item.Status == "OK")
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Status</span>
                    }
                </td>
                <td>@item.Note</td>
            </tr>
        }
    </tbody>
</table>
